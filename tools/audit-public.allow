# Allow list for tools/audit-public.sh: one `path:pattern` line per
# allowance, `pattern` is the id the audit prints. Every line is
# reviewed by a human before a publication.

# Pattern tables of the audit script and of this allow list: the pattern
# names appear there as literals.
tools/audit-public.sh:home
tools/audit-public.sh:begin
tools/audit-public.sh:token
tools/audit-public.sh:gitflic
tools/audit-public.allow:gitflic

